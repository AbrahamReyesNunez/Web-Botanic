# Copia este archivo como .env y cambia los valores. .env no se sube al repositorio.

# Clave para entrar en /admin.html: 20 caracteres o más, difícil de adivinar.
# El servidor no arranca con la de este ejemplo (es pública) y avisa si es más corta de 20.
ADMIN_KEY=cambia-esta-clave

# Secreto para firmar los formularios y la huella de origen de la lista (cualquier texto largo y aleatorio).
# Si no se pone, se genera uno al arrancar: los formularios abiertos caducan al reiniciar
# y la misma IP deja de dar la misma huella.
FORM_SECRET=

# Puerto del servidor
PORT=3000

# Detrás de un proxy, para que los límites por IP usen la IP real del visitante (X-Forwarded-For):
#   1      → proxy en el mismo equipo (cloudflared, Nginx local). El servidor solo escucha en 127.0.0.1
#            y solo cree la cabecera si la conexión viene del propio equipo.
#   remoto → proxy en otra máquina (Render, Railway…): se cree la cabecera venga de donde venga.
#   0      → sin proxy (en local, o para probar desde el móvil en la misma wifi).
TRUST_PROXY=0

# Dirección en la que escucha el servidor. Por defecto: 127.0.0.1 con TRUST_PROXY=1, todas si no.
# HOST=0.0.0.0

# Base de datos Supabase (ver README → "Base de datos"). Sin estas dos líneas, los datos van a data/db en JSON.
# Supabase → Project Settings → API Keys. La clave secreta (sb_secret_…) solo va aquí: nunca en el código ni en GitHub.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Clave para que el panel suba las fotos de los eventos a Google Drive.
# La genera la función configurarClave del Apps Script (ver README → "Galería y Google Apps Script"
# y google-apps-script/Codigo.gs). Sin ella, el panel funciona pero no puede subir fotos.
DRIVE_SCRIPT_CLAVE=
