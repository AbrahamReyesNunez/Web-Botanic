# Copia este archivo como .env y cambia los valores. .env no se sube al repositorio.

# Clave para entrar en /admin.html (larga y difícil de adivinar)
ADMIN_KEY=cambia-esta-clave

# Secreto para firmar los formularios de la lista (cualquier texto largo y aleatorio).
# Si no se pone, se genera uno al arrancar y los formularios abiertos caducan al reiniciar.
FORM_SECRET=

# Puerto del servidor
PORT=3000

# Pon 1 solo si el servidor está detrás de un proxy (Render, Railway, Nginx...)
# para que el límite por IP use la IP real del visitante.
TRUST_PROXY=0
